# Copy to .codex/deploy-aws-ec2-ssm.env and fill in local AWS values.
# Keep the real file out of Git. Do not store AWS keys or application secrets here.

AWS_PROFILE='your-aws-profile'
AWS_REGION='cn-northwest-1'
AWS_INSTANCE_ID='i-xxxxxxxxxxxxxxxxx'
S3_BUCKET='your-private-deployment-bucket'
S3_PREFIX='deploy'
REQUIRED_INSTANCE_TAGS='AlwaysOn=True'
ENSURE_INSTANCE_TAGS=true

PROJECT_NAME='ms-365-21v-mcp-server-pro'
REMOTE_APP_DIR='/opt/ms365-21v-mcp'
SYSTEMD_SERVICE='ms365-21v-mcp.service'
REMOTE_OWNER='ec2-user:ec2-user'

LOCAL_VERIFY_COMMAND='npm run build'
INSTALL_COMMAND='/usr/bin/npm ci'
BUILD_COMMAND='/usr/bin/npm run build'

PRESERVE_PATHS='.env'
REQUIRE_PRESERVE_PATHS=true
EXCLUDE_PATHS='.git .env node_modules dist .DS_Store .tokens mcp.log .codex/deploy-aws-ec2-ssm.env'

REMOTE_HEALTH_URL='http://127.0.0.1:3000/healthz'
REMOTE_HEALTH_ATTEMPTS=30
REMOTE_HEALTH_INTERVAL_SECONDS=1
PUBLIC_HEALTH_URL='https://mcp.example.com/healthz'
PUBLIC_HEALTH_ATTEMPTS=10
PUBLIC_HEALTH_INTERVAL_SECONDS=2

REQUIRE_CLEAN_GIT=true
BACKUP_RETENTION=1
PRESIGN_TTL_SECONDS=1800
SSM_TIMEOUT_SECONDS=600
