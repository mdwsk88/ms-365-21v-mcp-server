# Full configuration reference. First-time users can run npm run setup instead.
# 21V / Microsoft Entra tenant.
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=
# Legacy upstream public/native login client. Retained for backward compatibility.
MS_PUBLIC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Microsoft client used by the OAuth bridge. Leave these empty to use the mode-specific fallback:
# public -> MS_PUBLIC_CLIENT_ID; confidential_web -> MS_CLIENT_ID / MS_CLIENT_SECRET.
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# Microsoft 365 operated by 21Vianet.
# Some tenants use https://login.chinacloudapi.cn; override if your IT admin confirms that endpoint.
MS_AUTHORITY_HOST=https://login.partner.microsoftonline.cn
MS_GRAPH_BASE_URL=https://microsoftgraph.chinacloudapi.cn/v1.0

# Streamable HTTP MCP endpoint.
MCP_TRANSPORT=http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
# AgentRun catalog endpoint. It may allow anonymous initialize/tools/list so the
# platform can import the tool schema.
MCP_HTTP_PATH=/mcp
# Optional separate endpoint for OAuth-capable clients. When set, this endpoint
# never allows anonymous discovery and becomes the protected resource URL.
# AgentRun example: /oauth-mcp
MCP_OAUTH_HTTP_PATH=
# Keep false for traditional stateful servers. Set true on AgentRun so OAuth
# discovery and callback requests are not tied to an MCP session header.
MCP_HTTP_STATELESS=false

# Optional public mount URL, including the platform path prefix but excluding /mcp.
# Example: https://tenant.agentrun-data.cn-hangzhou.aliyuncs.com/tools/MCP_21V
# When set, it supplies defaults for the resource URL, metadata URL, OAuth issuer,
# and fixed Microsoft callback. The explicit URL variables below remain overrides.
MCP_PUBLIC_BASE_URL=

# Optional explicit resource URL. Leave empty to derive it from MCP_PUBLIC_BASE_URL.
# A nonempty value overrides that base URL. Never leave an example hostname here.
MCP_RESOURCE_URL=
# Optional. Defaults to <origin>/.well-known/oauth-protected-resource/<path>.
MCP_RESOURCE_METADATA_URL=
MCP_RESOURCE_DOCUMENTATION_URL=

# The OAuth authorization server advertised to MCP clients.
# Defaults to <MS_AUTHORITY_HOST>/<MS_TENANT_ID>/v2.0.
# In MCP_OAUTH_BRIDGE_ENABLED=true mode, leave empty to advertise this MCP server origin instead.
MCP_AUTHORIZATION_SERVERS=

# Scope MCP clients should request from 21V Entra for this MCP resource.
# If your MCP App exposes api://<mcp-app-client-id>/access_as_user, use that full value here.
MCP_AUTHORIZATION_SCOPES=api://00000000-0000-0000-0000-000000000000/access_as_user

# Audience and scope checks for inbound client -> MCP tokens.
# Entra commonly emits only "access_as_user" in the access token's scp claim.
MCP_TOKEN_AUDIENCE=api://00000000-0000-0000-0000-000000000000
MCP_REQUIRED_TOKEN_SCOPES=access_as_user
MCP_TOKEN_ISSUER=
MS_OIDC_METADATA_URL=
MCP_INBOUND_AUTH_DISABLED=false
# Optional for platforms such as AgentRun that fetch MCP tool lists before they can attach a user token.
# This only allows initialize/tools-list style discovery without Bearer; tool calls still require auth.
MCP_ALLOW_UNAUTHENTICATED_DISCOVERY=false

# OAuth bridge mode is useful when the upstream IdP does not expose MCP-compatible
# OAuth authorization server metadata or dynamic client registration.
MCP_OAUTH_BRIDGE_ENABLED=false
# public keeps the legacy native-client flow. confidential_web uses a server-side
# Web/confidential client. Device acceptance still depends on Entra Conditional Access.
# Both modes support either one Entra app or the recommended two-app separation.
MCP_OAUTH_BRIDGE_MICROSOFT_CLIENT_TYPE=public
MCP_OAUTH_BRIDGE_ISSUER=
MCP_OAUTH_BRIDGE_REDIRECT_URI=
MCP_OAUTH_BRIDGE_SCOPES=
# Optional Microsoft authorize prompt. Use "login" only to troubleshoot a broken Windows account picker loop.
MCP_OAUTH_BRIDGE_PROMPT=
# Keep "redirect" for reliable automatic loopback delivery. "background" is cosmetic and
# some browsers may block the HTTPS-to-HTTP loopback request, requiring a manual fallback click.
MCP_OAUTH_BRIDGE_CALLBACK_DELIVERY=redirect
MCP_OAUTH_BRIDGE_STATE_PATH=.tokens/oauth-bridge-state.json

# Fallback OBO scopes used by raw/debug Graph calls. Normal MCP tools request their own least-needed
# Microsoft Graph delegated scopes in code. Add those delegated permissions in 21V Entra and grant
# admin consent before exposing the corresponding tools to users.
MS_OBO_GRAPH_SCOPES=https://microsoftgraph.chinacloudapi.cn/User.Read

# Local stdio/device-code development only. Add the scopes you want to test locally here.
MS_GRAPH_SCOPES=openid profile offline_access https://microsoftgraph.chinacloudapi.cn/User.Read
MS_TOKEN_CACHE_PATH=.tokens/21v-graph-token.json

# Keep disabled in production. This only allows arbitrary read-only Graph GET calls for debugging.
MS_ENABLE_RAW_GRAPH_GET=false

# ===== MCP Gateway =====

# Tool exposure strategy:
# - direct: expose every authorized tool with its full schema (fastest common path)
# - discovery: expose only gateway_search_tools/get_tool_schema/execute_tool
# - hybrid: expose the configured fast lane and discover all other authorized tools
MCP_TOOL_EXPOSURE_MODE=direct
# Used only by hybrid mode. Categories and exact names are combined.
MCP_DIRECT_TOOL_CATEGORIES=
MCP_DIRECT_TOOLS=graph_get_me,mail_list_messages,mail_search_messages,calendar_list_events,drive_search_items,smart_mail_digest,smart_calendar_conflicts

# Deployment-level tool filtering. Empty loads every module.
# Values: mail,calendar,drive,sharepoint,teams,contacts,users,groups,search,smart,debug
MCP_TOOL_CATEGORIES=

# Hide tools that require Graph delegated scopes which this tenant has not approved.
# Matching is case-insensitive and accepts either bare names or full Graph scope URLs.
# Remove a scope only after it appears in Entra API permissions with consent granted.
MCP_DISABLED_GRAPH_SCOPES=Channel.Create,Channel.Delete.All,ChannelMember.Read.All,ChannelMember.ReadWrite.All,ChannelMessage.Read.All,ChannelMessage.ReadWrite,ChannelMessage.Send,ChannelSettings.ReadWrite.All,ChatMember.ReadWrite,GroupMember.Read.All,TeamMember.Read.All,TeamMember.ReadWrite.All,User.Read.All

# Per-user filtering from Microsoft Entra App Roles. A roleless authenticated
# user receives only gateway/base tools. Set false temporarily during migration.
MCP_ROLE_BASED_FILTERING=true

# JSON Lines audit logs rotate daily as audit-YYYY-MM-DD.log with mode 0600.
MCP_AUDIT_LOG_ENABLED=true
MCP_AUDIT_LOG_PATH=.tokens/audit

# Message delivery policy. confirm (default) requires human approval for email
# and Teams sends. automatic sends immediately for unattended automation, but
# never bypasses OAuth, Graph permissions, App Roles, or audit logging.
MCP_SEND_MODE=confirm

# Comma-separated non-send operation types that require explicit approval. The gateway
# prefers MCP form elicitation and falls back to a secure web preview when the
# client does not support it. The web token is user-bound and one-time.
# Use all or * to gate every other confirmable write. MCP_SEND_MODE has explicit
# precedence for send_email and send_teams_message.
MCP_CONFIRM_OPERATIONS=delete_email,delete_mail_folder,delete_mail_attachment,create_event,cancel_event,delete_event,delete_calendar,delete_event_attachment,delete_drive_item,create_share_link,invite_drive_item,restore_drive_version,delete_sharepoint_list,delete_sharepoint_column,delete_sharepoint_list_item,delete_sharepoint_drive_item,invite_sharepoint_drive_item,restore_sharepoint_drive_version,delete_teams_message,delete_teams_channel,remove_teams_member,remove_teams_channel_member,remove_teams_chat_member,delete_contact,delete_contact_folder
MCP_CONFIRM_TTL_SECONDS=300

# Microsoft Graph retry, timeout, and circuit-breaker behavior.
MCP_GRAPH_MAX_RETRIES=3
MCP_GRAPH_INITIAL_BACKOFF_MS=1000
MCP_GRAPH_BACKOFF_MULTIPLIER=2
MCP_GRAPH_TIMEOUT_MS=30000
MCP_GRAPH_CIRCUIT_BREAKER_THRESHOLD=5
MCP_GRAPH_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Protects /admin/* REST endpoints. Use a long random value in production.
MCP_ADMIN_TOKEN=

# Reserved downstream MCP declarations. Parsing and registry hooks exist, but
# proxy discovery/forwarding is intentionally not implemented in this release.
# MCP_DOWNSTREAM_SERVICES=hr:https://hr-mcp.internal:3001,fleet:https://fleet-mcp.internal:3002
MCP_DOWNSTREAM_SERVICES=
