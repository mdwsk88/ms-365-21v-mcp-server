# Copy this file to .env on the machine running the MCP service, then fill MS_CLIENT_SECRET locally.
# This template is for OAuth 2.1 MCP clients such as Qoder Work, Workbuddy, or compatible clients.
# Do not commit the real .env file.

MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=
MS_PUBLIC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Optional generic upstream OAuth client override. Leave empty for the mode fallback.
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

MS_AUTHORITY_HOST=https://login.partner.microsoftonline.cn
MS_GRAPH_BASE_URL=https://microsoftgraph.chinacloudapi.cn/v1.0

MCP_TRANSPORT=http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp

MCP_RESOURCE_URL=http://127.0.0.1:3000/mcp
MCP_RESOURCE_METADATA_URL=
MCP_RESOURCE_DOCUMENTATION_URL=

MCP_AUTHORIZATION_SERVERS=http://127.0.0.1:3000
MCP_AUTHORIZATION_SCOPES=api://00000000-0000-0000-0000-000000000000/access_as_user
MCP_TOKEN_AUDIENCE=api://00000000-0000-0000-0000-000000000000
MCP_REQUIRED_TOKEN_SCOPES=access_as_user
MCP_TOKEN_ISSUER=
MS_OIDC_METADATA_URL=
MCP_INBOUND_AUTH_DISABLED=false

MCP_OAUTH_BRIDGE_ENABLED=true
# Existing deployment: public. For a one-app server-side Web login test, set
# confidential_web and leave MS_OAUTH_CLIENT_ID / MS_OAUTH_CLIENT_SECRET empty;
# the bridge then reuses MS_CLIENT_ID / MS_CLIENT_SECRET.
MCP_OAUTH_BRIDGE_MICROSOFT_CLIENT_TYPE=public
MCP_OAUTH_BRIDGE_ISSUER=http://127.0.0.1:3000
MCP_OAUTH_BRIDGE_REDIRECT_URI=http://localhost:3000/oauth/microsoft/callback
MCP_OAUTH_BRIDGE_SCOPES=openid profile offline_access api://00000000-0000-0000-0000-000000000000/access_as_user
# Leave empty for normal SSO. Set to "login" temporarily if the Microsoft page loops on
# "已连接到 Windows / 无法登录" before returning to the MCP client.
MCP_OAUTH_BRIDGE_PROMPT=
MCP_OAUTH_BRIDGE_STATE_PATH=.tokens/oauth-bridge-state.json

# confirm requires human approval for email/Teams sends; automatic is intended
# only for explicitly approved unattended automation deployments.
MCP_SEND_MODE=confirm

MS_OBO_GRAPH_SCOPES=https://microsoftgraph.chinacloudapi.cn/User.Read https://microsoftgraph.chinacloudapi.cn/Mail.Read https://microsoftgraph.chinacloudapi.cn/Mail.Send https://microsoftgraph.chinacloudapi.cn/Calendars.Read https://microsoftgraph.chinacloudapi.cn/Files.Read https://microsoftgraph.chinacloudapi.cn/Files.Read.All https://microsoftgraph.chinacloudapi.cn/Files.ReadWrite.All https://microsoftgraph.chinacloudapi.cn/Sites.Read.All https://microsoftgraph.chinacloudapi.cn/Sites.ReadWrite.All https://microsoftgraph.chinacloudapi.cn/Team.ReadBasic.All https://microsoftgraph.chinacloudapi.cn/Channel.ReadBasic.All

MS_GRAPH_SCOPES=openid profile offline_access https://microsoftgraph.chinacloudapi.cn/User.Read
MS_TOKEN_CACHE_PATH=.tokens/21v-graph-token.json
MS_ENABLE_RAW_GRAPH_GET=false

# direct preserves the full current catalog. Use hybrid with the fast-lane lists
# from .env.example to keep common tools direct and discover long-tail tools.
MCP_TOOL_EXPOSURE_MODE=direct
MCP_DIRECT_TOOL_CATEGORIES=
MCP_DIRECT_TOOLS=

# Current tenant permission boundary. Tools requiring any listed scope stay hidden
# until the permission is present and consented in 21V Entra.
MCP_DISABLED_GRAPH_SCOPES=Channel.Create,Channel.Delete.All,ChannelMember.Read.All,ChannelMember.ReadWrite.All,ChannelMessage.Read.All,ChannelMessage.ReadWrite,ChannelMessage.Send,ChannelSettings.ReadWrite.All,ChatMember.ReadWrite,GroupMember.Read.All,TeamMember.Read.All,TeamMember.ReadWrite.All,User.Read.All
