{
  "name": "ms-365-21v-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Policy-aware OAuth 2.1 MCP gateway for Microsoft 365 operated by 21Vianet",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdwsk88/ms-365-21v-mcp-server.git"
  },
  "homepage": "https://github.com/mdwsk88/ms-365-21v-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/mdwsk88/ms-365-21v-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "microsoft-365",
    "microsoft-graph",
    "21vianet",
    "oauth-2.1"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "ms365-21v-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:onboarding": "node --test test/onboarding.test.mjs",
    "docs:tools": "npm run build && node scripts/generate-tool-catalog.mjs",
    "check:public": "node scripts/public-release-check.mjs",
    "check:release": "node scripts/public-release-check.mjs --release",
    "export:public": "node scripts/export-public-snapshot.mjs",
    "benchmark:tools": "npm run build && node scripts/benchmark-tool-exposure.mjs",
    "package:agentrun": "bash scripts/package-agentrun.sh",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/msal-node": "5.3.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "17.4.2",
    "jose": "6.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
